# LLM API key (required — pick one)
GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-v1-...   # OpenAI models via OpenRouter (OpenAI-compatible API)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default model
# LLM_MODEL=gemini-2.5-flash
# When using OPENROUTER_API_KEY, model ids are prefixed with the provider, e.g.:
# LLM_MODEL=openai/gpt-4o-mini

# Optional: only used with OPENROUTER_API_KEY
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://your-app-url.example   # shown in OpenRouter dashboards
# OPENROUTER_SITE_NAME=langgraph-agent-lab           # shown in OpenRouter dashboards

# Optional: real HITL interrupts (default: mock approval)
# LANGGRAPH_INTERRUPT=true

# Optional: persistence backend
CHECKPOINTER=memory
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_lab

LOG_LEVEL=INFO
